# Copy to .env and adjust. No secret belongs in this file: the platform token is fetched on
# demand from SIG's login helper (~/.grp/token.json), never stored here.

# Environment label shown everywhere and typed to confirm a submit.
MSL_ENVIRONMENT=sig-hosted
# offline | rest | mcp. Chosen explicitly; a failure never falls back to another transport.
MSL_TRANSPORT=offline
MSL_PLATFORM_URL=https://servirplatform.sig-gis.com
# Defaults derived from MSL_PLATFORM_URL:
# MSL_MCP_URL=https://servirplatform.sig-gis.com/mcp
# MSL_REST_CONTRIBUTE_URL=https://servirplatform.sig-gis.com/api/contribute
# MSL_RESOURCE=https://servirplatform.sig-gis.com/mcp
# Path to SIG's helper, downloaded by scripts/fetch_grp_login.py
MSL_GRP_LOGIN_HELPER=tools/grp-login.py
MSL_OUTPUTS_DIR=outputs
MSL_REQUEST_TIMEOUT=60
